# قاعدة البيانات
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/medical_assistant?schema=public"

# JWT
JWT_SECRET="change_this_to_a_long_random_secret"
# عمر الـ access token فقط (قصير عمداً) — الجلسات الطويلة يتكفّل بها refresh token
# المُخزَّن كـ hash في قاعدة البيانات (صالح 30 يوماً، راجع auth.service.ts)
JWT_EXPIRES_IN="1h"

# الخادم
PORT=3000
# ضع "production" فقط عند النشر الفعلي — يفعّل قيود CORS ويخفي Swagger
NODE_ENV="development"
# نطاقات الويب/الموبايل المسموح لها بالاتصال بالـ API في الإنتاج (مفصولة بفواصل)
ALLOWED_ORIGINS="https://tabibi-wheat.vercel.app"

# (لاحقاً) Claude API للتشخيص المساعد
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5"

# (لاحقاً) SMS Gateway جزائري
SMS_GATEWAY_API_KEY=""
